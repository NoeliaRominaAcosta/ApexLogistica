@startuml FastDrop_C4_Containers
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title Diagrama de Contenedores (C4 Nivel 2) - Plataforma de Logística FastDrop

Person(customer, "Cliente", "Usuario que realiza compras y consulta el estado de su envío.")
Person(driver, "Conductor / Operador", "Personal logístico encargado de la recolección y entrega.")

System_Boundary(fastdrop_boundary, "Plataforma FastDrop") {

    Container(api_gateway, "API Gateway / Ingress", "Traefik / NGINX", "Punto de entrada único. Maneja TLS, Rate Limiting y enrutamiento.")

    Container(orchestrator_service, "Order Orchestrator Service", "Java 21, Spring Boot 3, Spring State Machine", "Orquesta la Saga de órdenes (OrderSaga SSM), maneja timeouts y publica comandos vía Transactional Outbox.")
    Container(warehouse_service, "Warehouse Service", "Java 21, Spring Boot 3, Spring State Machine", "Gestiona inventario y máquina de estados local StockReservation. Implementa Optimistic Locking y Outbox.")
    Container(dispatch_service, "Dispatch Service", "Java 21, Spring Boot 3, Spring State Machine", "Gestiona máquina de estados local Shipment, rutas con Resilience4j y Outbox.")
    Container(tracking_service, "Tracking Service", "Java 21, Spring Boot 3, Virtual Threads", "Provee consultas de tracking de alta concurrencia usando Cache-Aside en Redis.")

    ContainerDb(orchestrator_db, "Orchestrator DB", "PostgreSQL 16", "Almacena order_sagas, processed_messages y outbox_events.")
    ContainerDb(warehouse_db, "Warehouse DB", "PostgreSQL 16", "Almacena inventory_items, stock_reservations y outbox_events.")
    ContainerDb(dispatch_db, "Dispatch DB", "PostgreSQL 16", "Almacena shipments y outbox_events.")
    ContainerDb(redis_cache, "Tracking Cache", "Redis 7", "Almacena estados calientes de envíos con TTL e invalidación reactiva.")

    Container(kafka_broker, "Event Broker", "Apache Kafka (KRaft)", "Tópicos: 'warehouse.commands', 'dispatch.commands', 'warehouse.inventory-events', 'logistics.dispatch-events'.")
    Container(otel_collector, "OpenTelemetry / Zipkin", "OTel Collector / Zipkin", "Recolecta traces OTLP, métricas Micrometer y logs correlacionados.")
}

System_Ext(maps_api, "External Routing API", "API externa de mapas y geocodificación.")

Rel(customer, api_gateway, "Crea órdenes, cancela y consulta tracking", "HTTPS / JSON")
Rel(driver, api_gateway, "Reporta retiro, entrega o fallo en domicilio", "HTTPS / JSON")

Rel(api_gateway, orchestrator_service, "POST /api/orders, POST /api/orders/{id}/cancel", "HTTP / REST")
Rel(api_gateway, warehouse_service, "Administración de stock", "HTTP / REST")
Rel(api_gateway, dispatch_service, "Checkpoints de conductor (pick-up, deliver, delivery-failed)", "HTTP / REST")
Rel(api_gateway, tracking_service, "Consultas de tracking", "HTTP / REST")

Rel(orchestrator_service, orchestrator_db, "Persiste estado de OrderSaga y comandos en outbox", "JDBC / PostgreSQL")
Rel(orchestrator_service, kafka_broker, "Publica comandos a 'warehouse.commands' y 'dispatch.commands'", "Kafka Producer")
Rel_Back(orchestrator_service, kafka_broker, "Consume respuestas de 'warehouse.inventory-events' y 'logistics.dispatch-events'", "Kafka Consumer")

Rel(warehouse_service, warehouse_db, "Persiste inventario, reserva y outbox en una única TX", "JDBC / PostgreSQL")
Rel_Back(warehouse_service, kafka_broker, "Consume 'warehouse.commands'", "Kafka Consumer")
Rel(warehouse_service, kafka_broker, "Publica 'StockReserved', 'StockReservationRejected', 'StockCancelled'", "Kafka Producer")

Rel(dispatch_service, dispatch_db, "Persiste envíos y outbox", "JDBC / PostgreSQL")
Rel_Back(dispatch_service, kafka_broker, "Consume 'dispatch.commands'", "Kafka Consumer")
Rel(dispatch_service, kafka_broker, "Publica 'DeliveryScheduled', 'ShipmentPickedUp', 'ShipmentDelivered', 'DeliveryFailed', 'ShipmentCancelled'", "Kafka Producer")
Rel(dispatch_service, maps_api, "Calcula rutas con Circuit Breaker & Retry (Resilience4j)", "HTTPS / REST")

Rel(tracking_service, redis_cache, "Cache-Aside", "RESP Protocol")
Rel_Back(tracking_service, kafka_broker, "Consume eventos de inventario y despacho para actualizar proyección", "Kafka Consumer")

@enduml
