@startuml FastDrop_C4_Components
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title Diagrama de Componentes Hexagonal (C4 Nivel 3) - Orchestrator, Warehouse & Dispatch

Container_Boundary(orchestrator_boundary, "Order Orchestrator Service (Hexagonal)") {
    Component(orch_in_rest, "OrderController", "Driving Adapter (REST)", "POST /api/orders, POST /api/orders/{id}/cancel")
    Component(orch_in_kafka, "ParticipantRepliesKafkaListener", "Driving Adapter (Kafka)", "Consume respuestas de Warehouse y Dispatch")
    Component(orch_in_sched, "SagaTimeoutScheduler", "Driving Adapter (Scheduler)", "Detecta deadlines vencidos")
    Component(orch_app, "OrderSagaService", "Application Use Cases", "Coordina transiciones, idempotencia y persistencia")
    Component(orch_sm_out, "SagaStateMachineAdapter", "Driven Adapter (SSM)", "Ejecuta máquina OrderSaga sobre common-statemachine")
    Component(orch_outbox_out, "OutboxSagaCommandPublisherAdapter", "Driven Adapter (Outbox)", "Persiste comandos hacia warehouse.commands y dispatch.commands")
}

Container_Boundary(warehouse_boundary, "Warehouse Service (Hexagonal)") {
    Component(wh_in_kafka, "WarehouseCommandsKafkaListener", "Driving Adapter (Kafka)", "Consume ReserveStock, ConfirmReservation, ReleaseStock")
    Component(wh_in_rest, "WarehouseController", "Driving Adapter (REST)", "Endpoints de inventario y reservas")
    Component(wh_app, "ReservationService", "Application Use Cases", "Orquesta reserva, confirmación y cancelación")
    Component(wh_sm_out, "ReservationStateMachineAdapter", "Driven Adapter (SSM)", "Ejecuta máquina StockReservation (NEW -> STOCK_CHECK -> RESERVED/REJECTED -> CONFIRMED -> CANCELLED)")
    Component(wh_jpa_out, "ReservationPersistenceAdapter", "Driven Adapter (JPA)", "Persiste entidades con @Version")
    Component(wh_outbox_out, "OutboxDomainEventPublisherAdapter", "Driven Adapter (Outbox)", "Registra eventos en outbox_events")
}

Container_Boundary(dispatch_boundary, "Dispatch Service (Hexagonal)") {
    Component(disp_in_kafka, "DispatchCommandsKafkaListener", "Driving Adapter (Kafka)", "Consume ScheduleDelivery, CancelShipment")
    Component(disp_in_rest, "ShipmentController", "Driving Adapter (REST)", "pick-up, deliver, delivery-failed")
    Component(disp_app, "ShipmentService", "Application Use Cases", "Separa TX1 / Routing externo / TX2")
    Component(disp_sm_out, "ShipmentStateMachineAdapter", "Driven Adapter (SSM)", "Ejecuta máquina Shipment (PENDING_ROUTING -> SCHEDULED -> IN_TRANSIT -> DELIVERED/FAILED/CANCELLED)")
    Component(disp_routing_out, "ExternalRoutingApiAdapter", "Driven Adapter (Resilience4j)", "CircuitBreaker + Retry + Fallback")
}

Container(kafka_broker, "Apache Kafka", "Broker", "Comandos y Eventos de Dominio")

Rel(orch_in_rest, orch_app, "StartOrderSagaUseCase / CancelOrderSagaUseCase")
Rel(orch_in_kafka, orch_app, "HandleParticipantReplyUseCase")
Rel(orch_in_sched, orch_app, "HandleSagaTimeoutUseCase")
Rel(orch_app, orch_sm_out, "SagaStateMachinePort")
Rel(orch_app, orch_outbox_out, "SagaCommandPublisherPort")
Rel(orch_outbox_out, kafka_broker, "OutboxRelayWorker -> warehouse.commands / dispatch.commands")

Rel_Back(wh_in_kafka, kafka_broker, "warehouse.commands")
Rel(wh_in_kafka, wh_app, "Reserve / Confirm / Cancel UseCase")
Rel(wh_in_rest, wh_app, "Use Cases")
Rel(wh_app, wh_sm_out, "ReservationStateMachinePort")
Rel(wh_app, wh_jpa_out, "ReservationRepositoryPort")
Rel(wh_app, wh_outbox_out, "DomainEventPublisherPort")
Rel(wh_outbox_out, kafka_broker, "OutboxRelayWorker -> warehouse.inventory-events")

Rel_Back(disp_in_kafka, kafka_broker, "dispatch.commands")
Rel(disp_in_kafka, disp_app, "Schedule / Cancel UseCase")
Rel(disp_in_rest, disp_app, "PickUp / Deliver / ReportFailure UseCase")
Rel(disp_app, disp_sm_out, "ShipmentStateMachinePort")
Rel(disp_app, disp_routing_out, "RoutingPort")

@enduml
